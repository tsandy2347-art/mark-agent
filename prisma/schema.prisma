// ───────────────────────────────────────────────────────────────────
// Mark — JBC Finance Manager Agent — Prisma schema
//
// Source of truth: CLAUDE.md section 5 (build spec).
//
// Mark is a SINK. He reads findings from 7 specialists (each behind its own
// /api/findings + HUB_API_KEY) and caches them locally as IngestedFinding.
// He never edits a specialist's data or any source system. His only writes are
// his own orchestration records: poll status, briefs, correlated issues,
// goal metrics, Q&A log, alert delivery audit.
// ───────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  // Generate into the project tree so Next.js 16 Turbopack doesn't hash the
  // @prisma/client externalised module name. Local-path imports stay stable.
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/** Same shape as every other finance agent. SC + CQ. */
model Entity {
  id           String   @id @default(cuid())
  code         String   @unique // "SC" | "CQ"
  legalName    String
  xeroTenantId String
  createdAt    DateTime @default(now())
}

/**
 * One row per specialist Mark watches. Updated on every poll attempt — the
 * dashboard reads these to render the "specialist health" panel and the
 * brief assembler treats a `failed` / `stale` agent as its own finding.
 *
 * Spec section 5 — SpecialistRunStatus.
 */
model SpecialistRunStatus {
  id              String   @id @default(cuid())
  agent           String   @unique // "reconciliation" | "controls-audit" | ...
  lastRunAt       DateTime?
  lastRunStatus   String   @default("never") // "ok" | "exceptions" | "failed" | "stale" | "never"
  lastError       String?
  exceptionsOpen  Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([lastRunStatus])
}

/**
 * Mark's local cache of every finding pulled from the 7 specialists. The
 * bedrock for synthesis — pull once, query locally. Append-only on poll,
 * with `resolved` updated when the upstream specialist reports the same
 * finding as resolved.
 *
 * The composite unique on (specialistAgent, specialistFindingId) is the
 * dedup key — re-polling never duplicates a row.
 */
model IngestedFinding {
  id                   String   @id @default(cuid())
  specialistAgent      String   // "reconciliation" | "controls-audit" | ...
  specialistFindingId  String   // the id field on the source FinanceFinding
  at                   DateTime // when the specialist created the finding
  severity             String   // "critical" | "warning" | "info"
  isPeopleFlag         Boolean  @default(false)
  entityCode           String   // "SC" | "CQ" | "BOTH"
  domain               String
  detector             String
  title                String
  body                 String
  explanation          String?
  evidenceJson         Json
  amount               Decimal? @db.Decimal(14, 2)
  suggestedAction      String
  resolved             Boolean  @default(false)
  ingestedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([specialistAgent, specialistFindingId])
  @@index([entityCode, severity, resolved])
  @@index([isPeopleFlag, resolved])
  @@index([specialistAgent, resolved])
  @@index([detector])
  @@index([at])
}

/**
 * A brief Mark generated and (usually) delivered. Stores both the rendered
 * narrative and the audit trail of which specialist run states + ingested
 * findings it drew on, so any brief is replayable.
 *
 * Spec section 5 — FinanceBrief.
 */
model FinanceBrief {
  id               String   @id @default(cuid())
  briefType        String   // "daily" | "weekly" | "monthly" | "restricted"
  entityScope      String   // "SC" | "CQ" | "consolidated"
  generatedAt      DateTime @default(now())
  headline         String
  narrative        String
  sourcedRunIds    Json     // [{ agent, lastRunAt, lastRunStatus, exceptionsOpen }, ...]
  itemsForAction   Json     // serialised correlated issues, snapshot at brief time
  recipients       String   @default("") // comma-separated, audit trail
  deliveryStatus   String   @default("pending") // "sent" | "skipped" | "error" | "pending"
  deliveryError    String?

  correlatedIssues CorrelatedIssue[]

  @@index([briefType, generatedAt])
}

/**
 * The output of Function B — dedupe + correlate + prioritise. One underlying
 * issue is one row, even when 2+ specialists touched it. `sourceAgents` +
 * `sourceExceptionIds` carry the audit trail back to ingested findings.
 *
 * Spec section 5 — CorrelatedIssue.
 */
model CorrelatedIssue {
  id                  String   @id @default(cuid())
  briefId             String?
  brief               FinanceBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  title               String
  detail              String
  priority            String   // "today" | "this-week" | "note"
  sourceAgents        Json     // ["payables", "controls-audit"]
  sourceExceptionIds  Json     // [{ agent, findingId }, ...]
  isRestricted        Boolean  @default(false) // people / pay data routing flag
  isConflict          Boolean  @default(false) // two specialists disagree about a fact
  entityCode          String   @default("BOTH")
  amount              Decimal? @db.Decimal(14, 2)
  resolved            Boolean  @default(false)
  resolvedAt          DateTime?
  resolvedBy          String?
  createdAt           DateTime @default(now())

  @@index([priority, resolved])
  @@index([isRestricted, resolved])
  @@index([briefId])
}

/**
 * The numbers Mark tracks honestly toward Tony's goals. Profit toward $3M is
 * the headline; labour cost %, DSO, GST owed, unclaimed revenue are the
 * supporting tape. Append-only — each capture is a row, trend is computed
 * over the history.
 *
 * Spec section 5 — GoalMetric.
 */
model GoalMetric {
  id          String   @id @default(cuid())
  metric      String   // "profit-run-rate" | "labour-cost-pct" | "dso" | "unclaimed-revenue" | "net-gst"
  entityScope String   // "SC" | "CQ" | "consolidated"
  periodLabel String   // "2026-05" | "2026-Q2" | "2026-05-26" depending on metric
  value       Decimal  @db.Decimal(18, 4)
  target      Decimal? @db.Decimal(18, 4)
  trend       String   @default("flat") // "improving" | "flat" | "worsening"
  capturedAt  DateTime @default(now())

  @@index([metric, capturedAt])
  @@index([entityScope, metric])
}

/**
 * Natural-language Q&A log. Every question + answer Mark gives, with the
 * timestamp of the data he answered from. Auditable, replayable, and lets
 * us spot if Mark started inventing numbers.
 *
 * Spec section 5 — FinanceQuery.
 */
model FinanceQuery {
  id          String   @id @default(cuid())
  askedBy     String
  question    String
  answer      String
  dataAsOf    DateTime
  createdAt   DateTime @default(now())

  @@index([askedBy, createdAt])
}

/**
 * Audit trail of every email Mark sent. Same shape as the specialists' own
 * AlertDelivery rows — channel-gated peopleFlagsIncluded confirms restricted
 * routing held.
 */
model AlertDelivery {
  id                  String   @id @default(cuid())
  channel             String   // "daily-brief" | "restricted-brief" | "weekly-report" | "monthly-pack" | "heartbeat-failure"
  recipients          String
  subject             String
  flagsCount          Int      @default(0)
  peopleFlagsIncluded Boolean  @default(false) // must be false on every channel except restricted-brief
  status              String   // "sent" | "skipped" | "error"
  errorMessage        String?
  briefId             String?
  sentAt              DateTime @default(now())

  @@index([channel, sentAt])
}

/**
 * 13-week cash forecast — REWORKED 2026-06 (Tony's v1 verdict: too much manual
 * entry, "get the information from Xero"). This model is now an append-only
 * JSON SNAPSHOT of one forecast save, holding BOTH entities (SC + CQ).
 *
 * The bulk of each save is AUTO-PULLED from Xero (via the payroll-poster box's
 * read-only /cash-inputs endpoint — Mark holds no Xero keys):
 *   - bank accounts + which count as spendable cash
 *   - money owed (AR) split into the 7 JBC debtor types by income account
 *   - bills owed (AP)
 * Only a few forward-looking outflow assumptions are human-entered (weekly
 * payroll, super, PAYG, ATO plan) and the collection cadences — all persisted
 * in the snapshot so Tony confirms rather than re-types each week.
 *
 * The forecast (per-entity + combined) is computed on the fly from `state`
 * (see lib/cash-forecast.ts). Newest asOfDate wins.
 */
model CashForecastSnapshot {
  id        String   @id @default(cuid())
  asOfDate  DateTime @db.Date
  state     Json // full CashForecastState (both entities + assumptions + cadences)
  notes     String   @default("")
  savedBy   String   @default("") // basic-auth username, audit
  createdAt DateTime @default(now())

  @@index([asOfDate(sort: Desc)])
}

/**
 * One uploaded SET of the three MYOB exports for a payroll journal run, kept
 * together so the payroll agent (in the brain) can fetch the exact same set it
 * will post from. Stored when Tony previews on /payroll-journal; fetched by the
 * brain over HTTP at post time (same pattern as CsvImport / the imports API).
 * Append-only — each preview is a new set, newest wins.
 */
model PayrollUpload {
  id             String   @id @default(cuid())
  summaryName    String
  summaryBytes   Bytes
  dataName       String
  dataBytes      Bytes
  detailName     String
  detailBytes    Bytes
  // Snapshot of the parsed preview (meta + totals) for audit / display.
  previewJson    Json?
  posted         Boolean  @default(false)
  postedAt       DateTime?
  uploadedBy     String   @default("")
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/**
 * Raw source-file uploads that Mark holds for the read-only Hermes skills.
 *
 * Tony / Lindsay drop MYOB pay exports + AlayaCare service-delivery exports
 * into /imports. The bytes live here (Postgres bytea). The skills
 * jbc-payroll-labour and jbc-revenue-claims fetch the latest CSV of a kind
 * via GET /api/imports/{kind}/latest on each run — that's how a separate
 * Railway service with its own volume gets at the file.
 *
 * Append-only — every upload is a row; "latest" = MAX(uploadedAt). When a
 * skill run consumes a row it stamps processedAt + processedRunId so we can
 * see which CSV powered which audit run.
 */
model CsvImport {
  id              String   @id @default(cuid())
  kind            String   // "myob" | "alayacare"
  entityCode      String?  // "SC" | "CQ" | null (applies to all / unspecified)
  filename        String
  mimeType        String
  sizeBytes       Int
  bytes           Bytes
  uploadedAt      DateTime @default(now())
  uploadedBy      String   // basic-auth peer e.g. "user:tony"
  processedAt     DateTime?
  processedRunId  String?  // links to skill-side audit_runs.id when consumed
  notes           String?

  @@index([kind, uploadedAt(sort: Desc)])
}

/**
 * MonthlyFinancials — Mark's permanent Profit & Loss history book.
 *
 * WHY: the live Xero P&L pull (via the poster) costs ~8 Xero API calls per peek
 * (4 months x 2 entities) and Xero's uncertified tier caps each entity at ~1000
 * calls/day. CLOSED months never change, so there is no reason to re-fetch them.
 * Tony uploads the 24-month Xero P&L export (one per entity) on the /financials
 * page; we parse each closed month into a row here ONCE. Mark then answers profit
 * questions for closed months straight from this table (zero Xero calls), and
 * only hits Xero live for the current, still-moving month.
 *
 * One row per (entityCode, month). Re-uploading the same month overwrites it
 * (upsert) so corrections/restatements are easy. `month` is "YYYY-MM".
 */
model MonthlyFinancials {
  id                      String   @id @default(cuid())
  entityCode              String   // "SC" | "CQ"
  month                   String   // "YYYY-MM" e.g. "2026-04"
  totalIncome             Float?
  totalCostOfSales        Float?
  grossProfit             Float?
  totalOtherIncome        Float?
  totalOperatingExpenses  Float?
  netProfit               Float?
  // Per-account breakdown for the month: array of
  // { section, account, amount } so Mark can answer "what were the expenses".
  lineItems               Json?
  sourceFilename          String?  // the upload it came from, for audit
  uploadedBy              String   // basic-auth peer e.g. "user:tony"
  uploadedAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([entityCode, month])
  @@index([entityCode, month])
}

/**
 * PayrollMonth — Mark's monthly labour-cost breakdown, grouped from MYOB weekly
 * pay runs (Tony's choice: weekly runs rolled into the month their pay date
 * falls in, to line up with the monthly P&L). One row per (entity, month).
 *
 * WHY: the P&L shows wages as one lump. This breaks labour cost down by PAY TYPE
 * (ordinary hours, overtime, casual loading, weekend/shift loadings, travel,
 * leave, super, allowances) so Mark can answer real CFO questions like "how much
 * overtime did SC pay in May" or "what's our travel-allowance spend". `lineItems`
 * is an array of { payType, category, amount }. NOTE: this is NOT split by
 * funding stream (NDIS vs Home Care) — MYOB pay codes describe pay TYPE, not the
 * client programme; that split would need an AlayaCare visit join.
 */
model PayrollMonth {
  id                String   @id @default(cuid())
  entityCode        String   // "SC" | "CQ"
  month             String   // "YYYY-MM"
  totalGross        Float?   // sum of Income-type lines (actual wage cost)
  totalSuper        Float?   // Employer Super
  totalAllowances   Float?   // Allowances
  totalLeaveTaken   Float?   // leave actually taken (Entitlement Payment)
  payRuns           Json?    // pay-run IDs rolled into this month (audit)
  lineItems         Json?    // [{ payType, category, amount }], biggest first
  sourceFilename    String?
  uploadedBy        String
  uploadedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([entityCode, month])
  @@index([entityCode, month])
}
