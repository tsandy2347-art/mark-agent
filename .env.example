# ───────────────────────────────────────────────────────────────────
# Mark — JBC Finance Manager Agent — environment template
# Copy to .env.local for local dev. Set in Railway dashboard for prod.
# Spec: CLAUDE.md (build spec, section 7).
# ───────────────────────────────────────────────────────────────────

# ── Database (Mark's own; not shared with specialists) ────────────
DATABASE_URL=postgresql://user:pass@host:5432/mark

# ── Basic auth (human-facing pages + read APIs) ───────────────────
# Single-user: BASIC_AUTH_USER + BASIC_AUTH_PASS
# OR multi-user: BASIC_AUTH_USERS=tony:pwA,lindsay:pwB,nicole:pwC
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
BASIC_AUTH_USERS=

# Admin users. General dashboard access (today / briefs / goals / qa /
# specialists). Lowercase.
ADMIN_USERNAMES=tony

# Restricted users — the ONLY usernames that see /restricted and that get
# people / individual-pay content via the Q&A endpoint. Lowercase.
# Default: Tony + Lindsay (people) + Nicole (pay).
MARK_RESTRICTED_USERNAMES=tony,lindsay,nicole

# ── Specialist endpoints (one base URL per agent) ─────────────────
# Mark calls ${URL}/api/findings with Authorization: Bearer ${HUB_API_KEY}.
# Leave a URL blank to disable polling for that specialist — Mark will record
# "failed: no SPECIALIST_*_URL configured" and surface it as a brief item.
SPECIALIST_RECONCILIATION_URL=
SPECIALIST_CONTROLS_AUDIT_URL=https://controls-audit-agent-production.up.railway.app
SPECIALIST_PAYROLL_LABOUR_URL=
SPECIALIST_PAYABLES_URL=
SPECIALIST_REVENUE_CLAIMS_URL=
SPECIALIST_RECEIVABLES_URL=
SPECIALIST_TAX_COMPLIANCE_URL=

# Shared Bearer Mark presents to every specialist's /api/findings.
# Same value lives on every specialist's HUB_API_KEY env var.
HUB_API_KEY=

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Cadence (Brisbane local) — spec section 7 ─────────────────────
# Display/config values only — the Railway cron sidecars set the actual UTC
# cron schedules; see cron/railway.toml comments.
MARK_DAILY_BRIEF_TIME=07:00
MARK_WEEKLY_REPORT_DAY=1
MARK_MONTHLY_PACK_DAY=3
# A specialist not seen inside this window becomes a brief item ("silent").
MARK_SPECIALIST_STALE_HOURS=36

# ── Report routing — spec section 6 ───────────────────────────────
MARK_DAILY_RECIPIENTS=
MARK_RESTRICTED_RECIPIENTS=
MARK_WEEKLY_RECIPIENTS=
MARK_MONTHLY_RECIPIENTS=
MARK_HEARTBEAT_RECIPIENTS=

# ── Goal targets — spec section 7 ─────────────────────────────────
GOAL_PROFIT_TARGET_AUD=3000000
GOAL_LABOUR_COST_TARGET_PCT_SC=72
GOAL_LABOUR_COST_TARGET_PCT_CQ=72
GOAL_DSO_TARGET_DAYS=35

# ── Q&A channel — spec section 4 (CONFIRM C1) ─────────────────────
# "dashboard-chat" (default — uses the /qa page) or "helpdesk" (future).
MARK_QA_CHANNEL=dashboard-chat

# ── Email plumbing ────────────────────────────────────────────────
REPORT_FROM=mark@justbettercareqld.com.au
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Cron auth ─────────────────────────────────────────────────────
CRON_SECRET=

# ── Mock mode ─────────────────────────────────────────────────────
# When true, Mark never calls a specialist — uses canned fixtures from
# lib/mark/mock/fixtures.ts so the whole brief pipeline is exercisable.
MARK_MOCK=
